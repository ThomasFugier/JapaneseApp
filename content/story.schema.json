{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "language": {
      "type": "string",
      "const": "ja"
    },
    "definitionLanguage": {
      "type": "string",
      "const": "fr"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reading": {
      "type": "string",
      "pattern": "^[ぁ-ゖー]+$"
    },
    "titleWords": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "type": "string",
            "pattern": "^[ぁ-ゖー]+$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text",
          "reading",
          "meaning"
        ],
        "additionalProperties": false
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "N5",
        "N4"
      ]
    },
    "theme": {
      "type": "string",
      "enum": [
        "cat",
        "rain",
        "moon",
        "train",
        "letter",
        "sea"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "paragraphs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "minItems": 1,
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "reading": {
                  "type": "string",
                  "pattern": "^[ぁ-ゖー]+$"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "text",
                "reading",
                "meaning"
              ],
              "additionalProperties": false
            },
            {
              "type": "string",
              "pattern": "^[、。「」！？]+$"
            }
          ]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "language",
    "definitionLanguage",
    "id",
    "title",
    "reading",
    "subtitle",
    "level",
    "theme",
    "description",
    "paragraphs"
  ],
  "additionalProperties": false
}
