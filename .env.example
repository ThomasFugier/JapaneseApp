# Copiez vers .env.local ; ne commitez jamais ce fichier rempli.
# URL canonique de production. En local : APP_URL=http://localhost:3000
APP_URL=https://japanese-srs-two.vercel.app
# OAuth App GitHub : Homepage URL = APP_URL
# Authorization callback URL = https://japanese-srs-two.vercel.app/api/auth/callback
# Pour le développement, utilisez une OAuth App dédiée avec le callback local.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER=ThomasFugier
GITHUB_DATA_OWNER=ThomasFugier
GITHUB_DATA_REPO=NihongoData
GITHUB_DATA_BRANCH=main
# Fine-grained PAT : un seul dépôt privé, Contents lecture/écriture.
# Ces secrets restent côté serveur ; ne pas utiliser de préfixe NEXT_PUBLIC_.
GITHUB_DATA_TOKEN=
# Valeur aléatoire de 32 caractères au minimum, indépendante du token GitHub.
SESSION_SECRET=
